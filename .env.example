# GitHub Buddy Configuration

# Server Port (Default: 5000)
PORT=5000

# Client Port (Default: 5173)
CLIENT_URL=http://localhost:5173

# GitHub Personal Access Token (Optional, but increases rate limits from 60 to 5000 requests/hour)
# Generate a classic token at https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=

# LLM API Key for AI Q&A (Optional - Gemini API or OpenAI API)
# If provided, AI responses will use the live LLM with grounded repository context.
# If omitted, GitHub Buddy uses an intelligent deterministic grounded Q&A engine.
GEMINI_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=
